# Settings for `docker compose`. Copy to .env.docker and fill in. Keep .env.docker secret.

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
# Plain http on localhost: allow cookies without HTTPS. Set both to true behind HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# PostgreSQL (used by both the db and web containers)
POSTGRES_DB=docassist
POSTGRES_USER=docassist
POSTGRES_PASSWORD=change-me

# AI (more providers can be added in the portal, AI providers page)
GOOGLE_API_KEY=

# Optional first superadmin, created on start if it doesn't exist
# DJANGO_SUPERUSER_USERNAME=platform-admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Local time zone for dates and times shown in the app
DJANGO_TIME_ZONE=Africa/Nairobi
