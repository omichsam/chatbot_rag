# Copy to django_app/.env. Never commit .env.
# GOOGLE_API_KEY is also read from ../.env (the Streamlit app's), so it can stay there.

# --- Django ---
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://docs.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
# false = only org admins can add people
ALLOW_SIGNUP=true

# --- Database (leave POSTGRES_DB empty to use SQLite) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RAG ---
# Where passage vectors live: chroma (a folder; works with any database) or
# pgvector (inside PostgreSQL with the vector extension; the Docker setup).
# After switching, run: python manage.py reindex
RAG_VECTOR_BACKEND=chroma
# Gemini key used by a Gemini provider with no key of its own. More AI providers
# (OpenAI, Claude, Groq, ...) are added by superadmins in the portal.
GOOGLE_API_KEY=
RAG_DEFAULT_MODEL=gemini-flash-latest
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_HISTORY_TURNS=3
RAG_MAX_UPLOAD_MB=25
RAG_INGEST_MODE=thread
RAG_INGEST_WORKERS=2
# Starting values for platform settings (afterwards change them in the portal)
RAG_QUOTED_FALLBACK=true
RAG_ANSWER_CACHE_SECONDS=86400
LOG_LEVEL=INFO
# RAG_VECTOR_DIR=/data/vector_store
# MEDIA_ROOT=/data/media
